# Payments provider: Blink (Galoy) — https://blink.sv
# Setting BLINK_API_KEY selects the Blink adapter automatically.
BLINK_API_KEY=your_blink_api_key_here
# BTC wallet UUID (auto-resolved from the account if unset)
BLINK_WALLET_ID=
# Optional: Svix webhook secret (whsec_...). Blink doesn't expose one; when unset,
# webhooks are pull-verified against the Blink API before being accepted.
BLINK_WEBHOOK_SECRET=

# Optional: force a provider (blink | nakapay). Default: auto-detect by API key.
# PAYMENTS_PROVIDER=blink

# Legacy NakaPay (provider dead since 2026-08-30 — kept only for reference)
# NAKAPAY_API_KEY=
# NAKAPAY_WEBHOOK_SECRET=
# NAKAPAY_DESTINATION_WALLET=

# Admin endpoints (/api/admin/restore, /api/admin/incidents). Unset = fail closed.
ADMIN_TOKEN=

# SQLite database (default ./pixels.db)
DB_PATH=./pixels.db

# Purchase size caps (defaults 1000)
MAX_BULK_PIXELS=1000
MAX_RECT_PIXELS=1000

# NEVER enable in production: gates /api/test-* endpoints
ENABLE_TEST_ENDPOINTS=
